COMPOSE_PROJECT_NAME=medassistant

# Public app
MEDASSISTANT_DOMAIN=medassistant.hakida.co.ke
MEDASSISTANT_BIND=127.0.0.1
MEDASSISTANT_PORT=3007

# Internal clinical database for this app only.
# This does not reuse the BI/n8n database.
CLINICAL_POSTGRES_BIND=127.0.0.1
CLINICAL_POSTGRES_PUBLIC_PORT=5545
CLINICAL_POSTGRES_DB=clinical_pathways
CLINICAL_POSTGRES_USER=clinical_user
CLINICAL_POSTGRES_PASSWORD=replace_with_long_random_password

# Qdrant vector database for this app only.
QDRANT_BIND=127.0.0.1
QDRANT_PUBLIC_PORT=6334
QDRANT_COLLECTION=clinical_guidelines

# Local Ollama for this app only.
# Note: a 4 GiB VPS may be tight for local LLM inference.
OLLAMA_BIND=127.0.0.1
OLLAMA_PUBLIC_PORT=11435
OLLAMA_MODEL=phi4-mini:3.8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional external model providers selectable from the admin panel.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# App authentication.
# Generate AUTH_SESSION_SECRET with: openssl rand -hex 32
AUTH_SESSION_SECRET=replace_with_64_hex_chars
ADMIN_PHONE=+254700000000
ADMIN_PASSWORD=replace_with_long_random_admin_password
